{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.3.0",
  "default_locale": "en",
  "key": "",
  "icons": {
    "16": "icons/lion-16.png",
    "32": "icons/lion-32.png",
    "48": "icons/lion-48.png",
    "128": "icons/lion-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/lion-16.png",
      "32": "icons/lion-32.png",
      "48": "icons/lion-48.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "i18n.js",
        "panel.js",
        "subtitles.js",
        "scheduler.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/lion-48.png"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
